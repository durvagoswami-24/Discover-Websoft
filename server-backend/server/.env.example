# MongoDB Atlas connection string (from Atlas dashboard -> Connect -> Drivers)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/discover-websoft?retryWrites=true&w=majority

# Any long random string -- used to sign customer JWTs
JWT_SECRET=change-this-to-a-long-random-string

# Any long random string -- used to sign admin JWTs (keep separate from JWT_SECRET)
ADMIN_JWT_SECRET=change-this-to-a-different-long-random-string

# The admin panel's login credential (per the Figma "Security Key" field).
# Only used once, by `npm run seed:admin`, to create the admin record.
# You can change it later directly in the database.
ADMIN_SECURITY_KEY=set-a-strong-admin-key-here

# Port the API server runs on
PORT=5000

# Your frontend's URL, for CORS
CLIENT_URL=http://localhost:5173

# Hostinger webmail account used to SEND notification emails (quote
# confirmations, admin lead alerts). Manage it at
# https://mail.hostinger.com/old/ -- EMAIL_USER is the full mailbox
# address, EMAIL_APP_PASSWORD is that mailbox's actual login password
# (no separate "app password" needed, unlike Gmail).
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USER=your-mailbox@yourdomain.com
EMAIL_APP_PASSWORD=your-mailbox-password

# Where new-lead notification emails are sent. Defaults to EMAIL_USER
# if left blank.
ADMIN_EMAIL=your-admin-inbox@yourdomain.com
